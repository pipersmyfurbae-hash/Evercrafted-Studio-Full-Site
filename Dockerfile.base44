# Base44 dev image: runtime + system libs needed by native deps (canvas, ffmpeg).
# Source is bind-mounted at runtime; dependencies install on first boot.
FROM node:22-bookworm

# System libraries required by the `canvas` native module (cairo/pango/jpeg/gif/rsvg)
# and by `fluent-ffmpeg` (ffmpeg binary). build-essential + python3 cover node-gyp.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      python3 \
      ffmpeg \
      libcairo2 \
      libpango-1.0-0 \
      libpangocairo-1.0-0 \
      libjpeg62-turbo \
      libgif7 \
      librsvg2-2 \
      libgl1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

EXPOSE 3000
